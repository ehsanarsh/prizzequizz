NODE_ENV=production
PORT=3000
API_BASE_PATH=/v1
APP_VERSION=0.1.0-beta
BUILD_ID=replace-with-ci-build-id
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com/v1

# Security
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
ADMIN_KEY=replace-with-strong-admin-key
CLOSED_BETA_REQUIRED=true

# Persistence
REPOSITORY_DRIVER=postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/prizzequizz
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_APP_NAME=prizzequizz-api

# Redis-backed services
REDIS_URL=redis://HOST:6379
REALTIME_ADAPTER=redis
LEADERBOARD_ADAPTER=redis
MATCHMAKING_ADAPTER=redis
MATCHMAKING_WORKER=true
MATCHMAKING_BOT_FALLBACK_MS=30000
MATCHMAKING_EXPIRE_MS=60000

# Payments
PAYMENT_PROVIDER=zarinpal
REWARD_HOLD_ENABLED=true
REWARD_HOLD_RISK_THRESHOLD=55

# Push notifications
PUSH_PROVIDER=webpush
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# Logging
LOG_LEVEL=info
