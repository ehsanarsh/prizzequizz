NODE_ENV=development
PORT=3000
API_BASE_PATH=/v1
JWT_ACCESS_SECRET=replace-in-production
JWT_REFRESH_SECRET=replace-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prizzequizz
REDIS_URL=redis://localhost:6379
REPOSITORY_DRIVER=memory
MATCHMAKING_ADAPTER=memory
MATCHMAKING_WORKER=true
MATCHMAKING_BOT_FALLBACK_MS=30000
MATCHMAKING_EXPIRE_MS=60000
REALTIME_ADAPTER=memory
LEADERBOARD_ADAPTER=memory
PUSH_PROVIDER=log
VAPID_SUBJECT=mailto:admin@prizzequizz.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
REWARD_HOLD_ENABLED=true
REWARD_HOLD_RISK_THRESHOLD=55
PAYMENT_PROVIDER=sandbox
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_APP_NAME=prizzequizz-api
CLOSED_BETA_REQUIRED=false
