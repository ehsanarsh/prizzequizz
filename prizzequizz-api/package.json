{
  "name": "prizzequizz-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/scripts/smoke.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "test:integration": "tsx src/tests/integration.ts",
    "test:realtime": "tsx src/tests/realtime-multi-instance.ts",
    "test:matchmaking": "tsx src/tests/matchmaking-load.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "db:verify": "tsx src/scripts/db-verify.ts",
    "env:validate": "tsx src/scripts/validate-env.ts"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "pg": "latest",
    "redis": "latest",
    "web-push": "^3.6.7",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/ws": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}