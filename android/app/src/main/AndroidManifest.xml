<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- Android 13+ will not show a single notification without this. The game
       already asks for web-push permission; without this the OS silently drops
       everything it sends. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:supportsRtl="true"
      android:allowBackup="true"
      android:usesCleartextTraffic="false"
      android:theme="@style/Theme.App">

    <meta-data
        android:name="asset_statements"
        android:resource="@string/asset_statements"/>

    <activity
        android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
        android:exported="true"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">

      <meta-data
          android:name="android.support.customtabs.trusted.DEFAULT_URL"
          android:value="@string/launch_url"/>
      <!-- The splash the player sees while the browser engine warms up: the
           game's own background and mascot, so the first frame is not a white
           flash. -->
      <meta-data
          android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
          android:resource="@mipmap/ic_launcher"/>
      <meta-data
          android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
          android:resource="@color/splash_background"/>
      <meta-data
          android:name="androidx.browser.trusted.category"
          android:value="Games"/>
      <!-- Full screen, and it STAYS full screen. Without this the app opens
           with the phone's status bar across the top and a black strip where
           the game should be; with plain "immersive" any stray edge swipe
           brings the bars back for good and the strip returns. Sticky hides
           them again on its own. -->
      <meta-data
          android:name="android.support.customtabs.trusted.DISPLAY_MODE"
          android:value="sticky-immersive"/>
      <meta-data
          android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
          android:resource="@color/splash_background"/>

      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>

      <!-- Opening a prizequiz.ir link goes to the app rather than the browser.
           This only takes effect once assetlinks.json on the domain names this
           app's signing certificate. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="@string/host_name"/>
      </intent-filter>
    </activity>

    <!-- Delivers web-push notifications to the Android notification tray. -->
    <service
        android:name="com.google.androidbrowserhelper.trusted.DelegationService"
        android:exported="true">
      <intent-filter>
        <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </service>
  </application>
</manifest>
