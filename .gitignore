node_modules/
dist/
*.log
.env
.DS_Store

# The compiled backend, packaged for deploy. It is `prizzequizz-api/dist`
# with the contents at the root — rebuilt from source every time, and ~370KB
# of binary that changes completely on each build. Thirteen copies of it are
# already in this history, which is thirteen copies too many.
pz-dist-contents.tgz

# The site bundle, packaged for deploy: `prizzequizz-site/dist` plus the
# design's `assets/`. Same story as pz-dist-contents.tgz — regenerated from
# source on every deploy, and 1.2MB of binary that changes wholesale each time.
pz-site-contents.tgz

# The same bundle packed the way the SERVER actually reads it — with the
# `dist/` prefix, because the container runs `node /app/dist/server.js` and a
# flat extract lands a level too high and is silently ignored. See
# deploy/UPDATE.md. Build artifact either way; not committed.
pz-site-dist.tgz

# The hand-off bundle: a full `git bundle --all`, rebuilt for every delivery.
# Committing it would store a copy of the whole repository inside the
# repository, and a new 12MB blob every time one is sent.
prizzequizzrepo.bundle

# backend src delivery tarballs (build artifacts, regenerated per deploy)
prizzequizz-api-src.tgz
prizzequizz-wallet-src.tgz
prizzequizz-api-*.tar.gz
