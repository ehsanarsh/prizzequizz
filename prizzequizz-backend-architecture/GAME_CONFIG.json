{
  "version": "2026.07.06-prod-001",
  "economy": {
    "free": {
      "enabled": true,
      "entryCurrency": "coins",
      "heartCostPerMatch": 1,
      "heartRechargeMinutes": 60,
      "maxAutoRechargeHearts": 5,
      "defaultCoins": 350,
      "showCash": false
    },
    "paid": {
      "enabled": true,
      "entryCurrency": "cash",
      "walletCurrency": "IRR",
      "withdrawFeePercent": 5,
      "showCash": true
    }
  },
  "globalRules": {
    "answerIdempotencyWindowSeconds": 30,
    "reconnectGraceSeconds": 45,
    "questionRepeatWindowDays": 14,
    "maxActiveMatchesPerUser": 1
  },
  "modes": {
    "duel": {
      "enabled": true,
      "displayName": "Duel",
      "playerCount": 2,
      "questionCount": 5,
      "timerSeconds": 10,
      "tieBreaker": "sudden_death",
      "entry": {
        "free": {
          "hearts": 1,
          "coins": 25
        },
        "paid": {
          "cash": 30000
        }
      },
      "reward": {
        "free": {
          "type": "coins",
          "base": 80,
          "perStage": 45,
          "perCorrect": 0,
          "continueMultiplier": 2
        },
        "paid": {
          "type": "cash",
          "winnerTakes": "entry_pool",
          "continueMultiplier": 2
        }
      },
      "progression": {
        "afterWin": ["collect_exit", "continue_double"],
        "afterLoss": ["view_summary", "home", "rematch_request"]
