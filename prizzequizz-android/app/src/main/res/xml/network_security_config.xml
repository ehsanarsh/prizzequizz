<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The game already runs behind a certificate, so there is no
     reason to leave plain HTTP available to anything on the device. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
